{
  "name": "schulplan",
  "productName": "Schulplan",
  "version": "1.8.0",
  "description": "Schulplan – der Organisations-Planer für Lehrkräfte der Astrid Lindgren Schule",
  "author": "Astrid Lindgren Schule",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "copy-www": "node scripts/copy-www.js",
    "start": "npm run copy-www && electron .",
    "dist": "node scripts/patch-builder.js && npm run copy-www && electron-builder --win nsis --x64",
    "postinstall": "node scripts/patch-builder.js",
    "dist-mac": "node scripts/patch-builder.js && npm run copy-www && electron-builder --mac zip --arm64 --x64",
    "dist-linux": "node scripts/patch-builder.js && npm run copy-www && electron-builder --linux deb --x64 && SCHULPLAN_APPIMAGE=1 electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "26.0.12",
    "resedit": "1.7.2"
  },
  "build": {
    "appId": "app.schulorga.lehrer.desktop",
    "productName": "Schulplan",
    "copyright": "Astrid Lindgren Schule",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "www",
        "to": "www"
      }
    ],
    "afterPack": "./scripts/afterPack.js",
    "compression": "maximum",
    "electronLanguages": [
      "de",
      "en",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Schulplan",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Schulplan",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Schulplan-Setup.${ext}"
    },
    "publish": null,
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.education",
      "identity": null,
      "darkModeSupport": true,
      "artifactName": "Schulplan-Mac-${arch}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "Schulplan nutzt die Kamera nur zum Scannen von Einladungs-QR-Codes.",
        "NSMicrophoneUsageDescription": "Schulplan nutzt das Mikrofon nur für die Lautstärke-Ampel. Es wird nichts aufgenommen.",
        "LSApplicationCategoryType": "public.app-category.education"
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "executableName": "schulplan",
      "synopsis": "Organisations-Planer für Lehrkräfte",
      "description": "Schulplan – Stundenplan, Klassen, Noten, Anwesenheit, Klassenbuch, Termine und Kollegium für Lehrkräfte der Astrid Lindgren Schule.",
      "maintainer": "Schulplan-Projekt <noreply@schulplan.invalid>",
      "vendor": "Astrid Lindgren Schule",
      "artifactName": "Schulplan-Linux.${ext}",
      "desktop": {
        "entry": {
          "Name": "Schulplan",
          "GenericName": "Schulplaner",
          "Comment": "Organisations-Planer für Lehrkräfte",
          "Keywords": "Schule;Lehrer;Stundenplan;Noten;Klassenbuch;"
        }
      }
    },
    "deb": {
      "packageName": "schulplan",
      "compression": "xz",
      "artifactName": "Schulplan-Linux.${ext}"
    },
    "appImage": {
      "artifactName": "Schulplan-Linux.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/superali99-tech/Schul-Organisation-App.git"
  }
}
